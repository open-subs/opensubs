# Copy to .env.local to enable the hosted options during development.
#
# The hosted translation endpoint. Until this is set, "OpenSubs" is not
# offered as a provider at all -- a paid option that cannot run is worse
# than an absent one.
VITE_OPENSUBS_TRANSLATE_URL=

# The credits API. While it is unset, credits.ts runs in mock mode: the
# balance lives in localStorage, "Add credits" simply adds them, and the
# interface says so in plain words. Prices are real in both modes -- they
# come from the engine, not from the mock.
VITE_CREDITS_API_URL=
