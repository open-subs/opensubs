{
  "name": "opensubs-web",
  "version": "1.0.2",
  "description": "OpenSubs in the browser -- subtitle authoring with the same engine the desktop app burns with",
  "type": "module",
  "private": true,
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "sync:ort": "bash scripts/sync-ort.sh",
    "predev": "npm run sync:ort",
    "prebuild": "npm run sync:ort",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node e2e/smoke.mjs",
    "test:cleanup": "node e2e/cleanup.mjs",
    "test:languages": "node e2e/languages.mjs",
    "test:videos": "node e2e/videos.mjs",
    "test:video-diff": "node e2e/video-diff.mjs",
    "burn": "node e2e/burn.mjs",
    "capture": "node e2e/capture.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:context": "node --experimental-strip-types e2e/context.mjs",
    "test:i18n": "node --experimental-strip-types e2e/i18n.mjs",
    "test:i18n-live": "node e2e/i18n-live.mjs",
    "test:vad": "node e2e/vad.mjs",
    "test:labels": "node --experimental-strip-types e2e/labels.mjs",
    "test:site-i18n": "SITE_SOURCE=${SITE_SOURCE:-../../../opensubs-website} python3 scripts/build-locale-pages.py --check --strict",
    "test:remote": "node --experimental-strip-types e2e/remote.mjs",
    "build:locales": "python3 scripts/build-locale-pages.py --strict",
    "test:iap": "node --experimental-strip-types e2e/iap.mjs",
    "test:engine": "node e2e/enginecheck/serve.mjs",
    "test:refill": "node --experimental-strip-types e2e/refill.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@openapps/sdk": "file:vendor/openapps/sdk",
    "@openapps/ui": "file:vendor/openapps/ui",
    "jassub": "^1.7.15",
    "mediabunny": "^1.55.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "playwright": "^1.62.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.3"
  }
}
