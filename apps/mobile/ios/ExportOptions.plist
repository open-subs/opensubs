<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Store, not ad-hoc or enterprise. Apple renamed this value
	     from "app-store" in Xcode 15; the old name still works but warns. -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- Filled in by scripts/archive.sh from the project's
	     DEVELOPMENT_TEAM, so the team id is written in one place. -->
	<key>teamID</key>
	<string>__TEAM_ID__</string>

	<!-- Manual, matching the project. Automatic signing asks Apple for a
	     *development* profile before it will make a distribution one, and a
	     development profile needs a registered device -- so on a machine
	     with no iPhone attached it fails with "your team has no devices",
	     which reads like an account problem and is not one. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>app.opensubs.mobile</key>
		<string>OpenSubs App Store</string>
	</dict>

	<key>stripSwiftSymbols</key>
	<true/>
	<key>uploadSymbols</key>
	<true/>

	<!-- Upload is a separate, explicit step in archive.sh. Doing it here
	     would mean an accidental export sent a build to App Store Connect,
	     and a build number cannot be reused once Apple has accepted it. -->
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
